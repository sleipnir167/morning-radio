# ローカル実行用。GitHub Actions では Secrets に同じ名前で登録する。
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Google Drive 配信を使う場合のみ
GDRIVE_FOLDER_ID=
GDRIVE_SERVICE_ACCOUNT_JSON=

# 任意の上書き（未設定なら config/config.yaml の値）
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# GENRE=科学・テクノロジー
# CHAPTERS=5
# CHARS_PER_CHAPTER=800
# TTS_VOICE=ja-JP-NanamiNeural
# SKIP_TTS=1
